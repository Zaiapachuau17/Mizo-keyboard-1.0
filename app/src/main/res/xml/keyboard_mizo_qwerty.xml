<?xml version="1.0" encoding="utf-8"?>
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="10%p"
    android:keyHeight="@dimen/key_height"
    android:horizontalGap="0px"
    android:verticalGap="4dp">

    <!-- Row 1: Q W E R T Y U I O P (T has Ṭ popup, U/I/O/E have tone popups) -->
    <Row>
        <Key android:codes="113" android:keyLabel="q" android:keyEdgeFlags="left" />
        <Key android:codes="119" android:keyLabel="w" />
        <Key android:codes="101" android:keyLabel="e" android:popupCharacters="êéèë3" />
        <Key android:codes="114" android:keyLabel="r" android:popupCharacters="4" />
        <!-- T key: Long-press directly pops up Mizo retroflex ṭ (U+1E6D) -->
        <Key android:codes="116" android:keyLabel="t" android:popupCharacters="ṭ5" />
        <Key android:codes="121" android:keyLabel="y" android:popupCharacters="6" />
        <Key android:codes="117" android:keyLabel="u" android:popupCharacters="ûúùü7" />
        <Key android:codes="105" android:keyLabel="i" android:popupCharacters="îíìï8" />
        <Key android:codes="111" android:keyLabel="o" android:popupCharacters="ôóòö9" />
        <Key android:codes="112" android:keyLabel="p" android:keyEdgeFlags="right" android:popupCharacters="0" />
    </Row>

    <!-- Row 2: A S D F G H J K L (A has â popup) -->
    <Row>
        <Key android:codes="97" android:keyLabel="a" android:horizontalGap="5%p" android:keyEdgeFlags="left" android:popupCharacters="âáàä@" />
        <Key android:codes="115" android:keyLabel="s" android:popupCharacters="#" />
        <Key android:codes="100" android:keyLabel="d" android:popupCharacters="$" />
        <Key android:codes="102" android:keyLabel="f" android:popupCharacters="%" />
        <Key android:codes="103" android:keyLabel="g" android:popupCharacters="&amp;" />
        <Key android:codes="104" android:keyLabel="h" android:popupCharacters="*" />
        <Key android:codes="106" android:keyLabel="j" android:popupCharacters="-" />
        <Key android:codes="107" android:keyLabel="k" android:popupCharacters="+" />
        <Key android:codes="108" android:keyLabel="l" android:keyEdgeFlags="right" android:popupCharacters="=" />
    </Row>

    <!-- Row 3: Shift, Z X C V B N M, Backspace (N has Ṅ popup, T has Ṭ) -->
    <Row>
        <Key android:codes="-1" android:keyLabel="⇧" android:keyWidth="15%p" android:isModifier="true" android:isSticky="true" android:keyEdgeFlags="left" />
        <Key android:codes="122" android:keyLabel="z" />
        <Key android:codes="120" android:keyLabel="x" />
        <Key android:codes="99" android:keyLabel="c" />
        <Key android:codes="118" android:keyLabel="v" />
        <Key android:codes="98" android:keyLabel="b" />
        <!-- N key: Long-press directly pops up Mizo velar ṅ (U+1E45) -->
        <Key android:codes="110" android:keyLabel="n" android:popupCharacters="ṅñ" />
        <Key android:codes="109" android:keyLabel="m" />
        <Key android:codes="-5" android:keyLabel="⌫" android:keyWidth="15%p" android:isRepeatable="true" android:keyEdgeFlags="right" />
    </Row>

    <!-- Row 4: ?123, Ṭ (Dedicated Mizo key), Space, Ṅ (Dedicated Mizo key), Enter -->
    <Row android:rowEdgeFlags="bottom">
        <Key android:codes="-2" android:keyLabel="?123" android:keyWidth="14%p" android:keyEdgeFlags="left" />
        <!-- Dedicated Mizo Ṭ Key for instant 1-tap typing without long-press -->
        <Key android:codes="7789" android:keyLabel="ṭ" android:keyWidth="10%p" android:popupCharacters="Ṭ" />
        <Key android:codes="32" android:keyLabel="Mizo" android:keyWidth="42%p" android:isRepeatable="false" />
        <!-- Dedicated Mizo Ṅ Key for instant 1-tap typing -->
        <Key android:codes="7749" android:keyLabel="ṅ" android:keyWidth="10%p" android:popupCharacters="Ṅ" />
        <Key android:codes="44" android:keyLabel="," android:keyWidth="10%p" />
        <Key android:codes="-4" android:keyLabel="↵" android:keyWidth="14%p" android:keyEdgeFlags="right" />
    </Row>

</Keyboard>
